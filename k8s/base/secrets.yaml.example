# Kubernetes Secrets Configuration
# IMPORTANT: This is an example file. Copy to secrets.yaml and fill with actual values.
# DO NOT commit secrets.yaml to version control!
# In production, use external secret management (AWS Secrets Manager, Vault, etc.)

---
apiVersion: v1
kind: Secret
metadata:
  name: database-secrets
type: Opaque
stringData:
  # RDS PostgreSQL connection URL
  # Format: postgresql://username:password@host:port/database
  url: "postgresql://postgres:CHANGEME@complaint-platform-db.REGION.rds.amazonaws.com:5432/complaints"

---
apiVersion: v1
kind: Secret
metadata:
  name: api-secrets
type: Opaque
stringData:
  # OpenAI API Key from https://platform.openai.com
  openai_api_key: "sk-CHANGEME"

---
apiVersion: v1
kind: Secret
metadata:
  name: aws-secrets
type: Opaque
stringData:
  # AWS credentials for S3 access
  # Best practice: Use IRSA (IAM Roles for Service Accounts) instead
  access_key_id: "CHANGEME"
  secret_access_key: "CHANGEME"

---
apiVersion: v1
kind: Secret
metadata:
  name: redis-secrets
type: Opaque
stringData:
  # Redis authentication token (from Terraform output: redis_auth_token)
  auth_token: "CHANGEME"

---
# For production, use External Secrets Operator to sync from AWS Secrets Manager:
# apiVersion: external-secrets.io/v1beta1
# kind: ExternalSecret
# metadata:
#   name: database-secrets
# spec:
#   refreshInterval: 1h
#   secretStoreRef:
#     name: aws-secrets-manager
#     kind: SecretStore
#   target:
#     name: database-secrets
#   data:
#   - secretKey: url
#     remoteRef:
#       key: complaint-platform/database
#       property: url
