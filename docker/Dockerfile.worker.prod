# Production-optimized Worker Dockerfile with multi-stage build
# Stage 1: Builder
FROM python:3.11-slim-bookworm AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --user --no-cache-dir --no-warn-script-location -r requirements.txt

# Stage 2: Runtime
FROM python:3.11-slim-bookworm

# Create non-root user
RUN groupadd -r worker && useradd -r -g worker worker

WORKDIR /app

# Install runtime dependencies for document processing
RUN apt-get clean && rm -rf /var/lib/apt/lists/* && \
    apt-get update -o Acquire::Check-Valid-Until=false && \
    apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    libpq5 \
    libmagic1 \
    poppler-utils \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy Python dependencies from builder
COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH

# Copy application code
COPY --chown=worker:worker . .

# Create uploads directory
RUN mkdir -p /app/uploads && chown -R worker:worker /app/uploads

# Security: Run as non-root user
USER worker

# Health check for Celery worker
HEALTHCHECK --interval=60s --timeout=30s --start-period=60s --retries=3 \
    CMD celery -A app.celery_app inspect ping -d celery@$HOSTNAME || exit 1

# Celery worker command with optimizations
CMD ["celery", "-A", "app.celery_app", "worker", \
    "--loglevel=info", \
    "--concurrency=4", \
    "--max-tasks-per-child=100", \
    "--max-memory-per-child=500000", \
    "--time-limit=3600", \
    "--soft-time-limit=3300", \
    "-Q", "documents,summaries,default", \
    "-n", "worker@%h"]
